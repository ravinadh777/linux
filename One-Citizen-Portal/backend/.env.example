# ─────────────────────────────────────────────────────────────────────────────
# oneCitizen Backend — environment configuration
# Copy to `backend/.env` and adjust per environment. NEVER commit real secrets.
# Deploying to a new environment = change these values only. No code/path changes.
# (Loaded by src/config/env.js via an absolute path, so cwd never matters.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (the frontend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Auth (JWT / HS256 in the reference build) ────────────────────────────────
# In production use a long random secret. MUST match the AskGov agent service
# JWT_SECRET so it can verify citizen tokens.
JWT_SECRET=change-me-dev-only-not-for-production
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=604800      # seconds (7 days)

# ── Persistence ──────────────────────────────────────────────────────────────
# json     → zero-setup file store (default; great for local dev & demos)
# postgres → PostgreSQL using the settings below (production)
PERSISTENCE_DRIVER=json
# Seed + runtime store root. Relative values resolve against the backend workspace root,
# never the CWD. Containers override this to the mounted volume path (e.g. /var/lib/onecitizen).
DATA_DIR=../data

# ── PostgreSQL (used only when PERSISTENCE_DRIVER=postgres) ───────────────────
# Preferred: a single connection string (managed Postgres / 12-factor).
# DATABASE_URL=postgresql://onecitizen:onecitizen@localhost:5432/onecitizen
# Or the discrete parts (ignored when DATABASE_URL is set):
PGHOST=localhost
PGPORT=5432
PGUSER=onecitizen
PGPASSWORD=onecitizen
PGDATABASE=onecitizen
PGSSL=false                 # true for managed/cloud Postgres
PG_POOL_MAX=10
PG_POOL_IDLE_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
DB_AUTO_MIGRATE=true        # create tables/indexes on boot
DB_SEED=true                # seed identities/clients if their tables are empty

# ── Uploads / integrations ───────────────────────────────────────────────────
MAX_UPLOAD_MB=25            # keep in step with the nginx client_max_body_size in infra/
MOCK_INTEGRATIONS=true

# Anti-virus adapter for document uploads: mock | off | clamav | service
# 'mock' flags the EICAR test string and a __INFECTED__ sentinel; the real scanners are
# wired in for production. 'off' behaves the same as 'mock' — it is NOT a bypass.
AV_SCANNER=mock

# ── AskGov agent gateway (Ask_Agent Python service) ──────────────────────────
AGENT_ENABLED=true
AGENT_SERVICE_URL=http://127.0.0.1:4100   # use 127.0.0.1 (not localhost) on Windows
AGENT_TIMEOUT_MS=30000
AGENT_RATE_WINDOW_MS=60000
AGENT_RATE_MAX=30
AGENT_HISTORY_REPLAY=20

