# Compose secrets + overrides. Copy to infra/docker/.env (gitignored) and fill in.
# Compose picks this file up automatically because it sits beside docker-compose.yml.
#
#   cp infra/docker/.env.example infra/docker/.env
#
# Variables marked REQUIRED use compose's `${VAR:?err}` syntax — the stack refuses to
# start without them rather than booting with an insecure default.

# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Signs citizen access tokens. The agent service verifies tokens with the SAME secret,
# so compose passes this one value to both; a mismatch shows up as agent calls 401-ing.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Postgres superuser password for the bundled database.
PGPASSWORD=

# ── Optional: LLM ─────────────────────────────────────────────────────────────
# Without OPENAI_API_KEY the agent runs its deterministic fallback and emits the identical
# AG-UI event stream — the stack is fully usable, just not model-driven.
OPENAI_API_KEY=
# Without a Tavily key, web_search returns curated mock results.
TAVILY_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024

# ── Optional: database ────────────────────────────────────────────────────────
PGUSER=onecitizen
PGDATABASE=onecitizen
# Host port for psql/pgAdmin. Bound to 127.0.0.1 only.
PG_PUBLISH_PORT=5432

# ── Optional: HTTP ────────────────────────────────────────────────────────────
WEB_PUBLISH_PORT=8080
# Must match the origin you actually browse to, or the API rejects the request.
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=oneCitizen

# ── Optional: behaviour ───────────────────────────────────────────────────────
LOG_LEVEL=info
# 'true' in any shared environment. 'false' lets unauthenticated calls act as DEMO_USER_ID.
AUTH_REQUIRED=true
DEMO_USER_ID=idn_citizen_1
MOCK_INTEGRATIONS=true
MAX_UPLOAD_MB=25
AGENT_TIMEOUT_MS=30000
BACKEND_TIMEOUT=6

# Image tag built/run by compose.
TAG=dev
