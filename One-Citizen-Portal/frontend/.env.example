# ─────────────────────────────────────────────────────────────────────────────
# oneCitizen Frontend — environment configuration (copy to `frontend/.env`).
# Vite exposes ONLY VITE_-prefixed vars to the browser. Deploying = change these.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the SPA calls for the API + AskGov agent gateway (/agent/*).
# Dev: keep this RELATIVE ('/api/v1') so requests use the Vite proxy — no CORS, no host
# coupling. Prod: set the absolute public API URL, e.g. https://api.onecitizen.gov.gy/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Dev-only: where the Vite proxy forwards /api requests.
VITE_API_TARGET=http://localhost:4000

# Feature flags / branding
VITE_MOCK=false
VITE_APP_NAME=oneCitizen

# ── MOHA Tint Waiver API ─────────────────────────────────────────────────────
VITE_TINT_ENV=staging                 # 'staging' | 'production'
# VITE_TINT_API_BASE_URL=             # optional explicit override of both origins
VITE_TINT_AUTH_MODE=broker            # 'broker' (production) | 'dev-token' (local demo)
