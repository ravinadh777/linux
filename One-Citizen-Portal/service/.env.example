# ── AskGov Agent Service env (copy to .env) ─────────────────────────────────
# Separate microservice for the oneCitizen portal. Never commit real secrets.

# HTTP
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info

# CORS — the Vite frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Identity ────────────────────────────────────────────────────────────────
# MUST match the oneCitizen backend JWT_SECRET so the agent can verify the
# access token the frontend already holds (HS256). See backend/.env.
JWT_SECRET=change-me-dev-only-not-for-production
JWT_ALG=HS256
# When true, a valid Bearer token is required. When false (dev), unauthenticated
# calls fall back to the demo citizen so you can try the SSE stream with curl.
AUTH_REQUIRED=false
DEMO_USER_ID=idn_citizen_1

# ── LLM (OpenAI) ────────────────────────────────────────────────────────────
# If OPENAI_API_KEY is unset, the service runs a deterministic fallback agent
# that emits the exact same AG-UI event stream — so it works out of the box.
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024

# ── Web search tool ─────────────────────────────────────────────────────────
# Optional. With a Tavily key the web_search tool returns live results; without
# one it returns curated mock results (still streamed as an AG-UI tool call).
# TAVILY_API_KEY=tvly-...

# Platform backend API — the agent reads LIVE citizen data (profile, applications).
BACKEND_API_URL=http://127.0.0.1:4000/api/v1
BACKEND_TIMEOUT=6
